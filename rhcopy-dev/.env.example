# ТОЛЬКО свежий горячий кошелёк под бота — никогда не основной
PRIVATE_KEY=
# @BotFather -> /newbot -> токен сюда
TELEGRAM_BOT_TOKEN=
# можно не заполнять: бот напишет в лог код, отправь ему /start КОД
TELEGRAM_CHAT_ID=
# необязательно: свой RPC без лимитов (Alchemy и т.п.), публичный иногда отвечает 429
RPC_URL=
RELAY_API_KEY=

# ---- Solana (необязательно)
# helius.dev → бесплатный ключ: даёт и RPC, и WebSocket для слежения в реальном времени
HELIUS_API_KEY=
# developers.jup.ag → бесплатный ключ: 1 запрос/с вместо 0.5 без ключа
JUPITER_API_KEY=
# или свои адреса вместо Helius:
SOLANA_RPC_URL=
SOLANA_WS_URL=

# ---- Ethereum / BNB Chain / Base (необязательно)
# свои RPC, например бесплатный ключ Alchemy: https://eth-mainnet.g.alchemy.com/v2/КЛЮЧ
# важно: узел должен отдавать eth_getLogs по topics без адреса контракта
ETH_RPC_URL=
BSC_RPC_URL=
BASE_RPC_URL=

# ---- Импорт KOL и фильтр инсайдеров (необязательно)
# madeonsol.com → API key. Бесплатный тариф: 200 запросов/день, лидерборд KOL и бандлы.
# Нужен для «🏆 Топ KOL из MadeOnSol» и для данных инсайдер-фильтра в Solana.
MADEONSOL_API_KEY=
# etherscan.io → API key (Etherscan V2). Нужен инсайдер-фильтру, чтобы узнать создателя токена в EVM.
ETHERSCAN_API_KEY=
