# ТОЛЬКО свежий горячий кошелёк под бота — никогда не основной
PRIVATE_KEY=
# @BotFather -> /newbot -> токен сюда
TELEGRAM_BOT_TOKEN=
# можно не заполнять: бот напишет в лог код, отправь ему /start КОД
TELEGRAM_CHAT_ID=
# необязательно: свой RPC без лимитов (Alchemy и т.п.), публичный иногда отвечает 429
RPC_URL=
RELAY_API_KEY=

# ---- Solana (необязательно)
# helius.dev → бесплатный ключ: даёт и RPC, и WebSocket для слежения в реальном времени
HELIUS_API_KEY=
# developers.jup.ag → бесплатный ключ: 1 запрос/с вместо 0.5 без ключа
JUPITER_API_KEY=
# или свои адреса вместо Helius:
SOLANA_RPC_URL=
SOLANA_WS_URL=

# ---- Ethereum (необязательно)
# свой RPC для Ethereum, например бесплатный ключ Alchemy: https://eth-mainnet.g.alchemy.com/v2/КЛЮЧ
ETH_RPC_URL=
